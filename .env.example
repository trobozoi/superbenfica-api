# =============================================================================
# Super Benfica API - modelo de variáveis de ambiente
# Copie para ".env" e preencha com os valores reais. Nunca versione o .env.
# =============================================================================

# config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Banco de dados PostgreSQL (Supabase). Todas obrigatórias.
DB_HOST=db.example.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me
# O Supabase exige SSL
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Redis (cache, WebSocket e Celery). Vazio = backends em memória (apenas dev).
# Obrigatório em produção (config.settings.prod não inicia sem ele); prefira rediss:// (TLS).
# Local (WSL/Docker): redis://localhost:6379/0
REDIS_URL=
# Limite de leitura do Redis no WebSocket (s). Deve ser maior que 5 (bloqueio do channels_redis).
# CHANNEL_LAYER_SOCKET_TIMEOUT=15
CACHE_TTL_RELATORIOS=300

# Rate limit (opcional; formato N/sec|min|hour|day). Padrões em config/settings/base.py
# THROTTLE_LOGIN=5/min
# THROTTLE_PEDIDOS_CRIACAO=30/min

# JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1

# Carga inicial (python manage.py carga_inicial)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
SEED_DEFAULT_PASSWORD=change-me

# Somente para o perfil "local-db" do docker-compose
LOCAL_DB_PASSWORD=change-me
